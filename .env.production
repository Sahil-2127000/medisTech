# Website build for Vercel (npm run build). Not used by local dev or the Android app.
# "/" = call the API on the website's own domain; vercel.json forwards /api to Render.
VITE_API_URL=/
# socket.io connects straight to the Render backend (Vercel can't proxy WebSockets).
VITE_SOCKET_URL=https://medistech-backend.onrender.com
